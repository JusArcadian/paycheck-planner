# Copy this file to ".env" (same folder) and fill it in.
# .env holds secrets: never upload it, share it, or paste it into ChatGPT.

# Make up a long random password. It goes at the end of your Gumroad ping URL:
#   https://YOUR-SERVER/gumroad?key=THIS_VALUE
WEBHOOK_SECRET=change-me-to-something-long-and-random

# Email (Gmail: turn on 2-step verification, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=Paycheck Planner <you@gmail.com>

# true = just print emails instead of sending (safe for testing)
DRY_RUN=true

# For sales_report.py
GUMROAD_ACCESS_TOKEN=
